# ApnaYaar AI - Environment Configuration Template
# Instructions:
# 1. Copy this file and rename the copy to '.env' (if not already present).
# 2. Open '.env' and paste your keys inside the quotes.
# 3. Keep '.env' private—never commit it to Git or share it publicly.

# Gnani.ai API Key (with Speech-to-Text & Text-to-Speech access)
GNANI_API_KEY="your_gnani_api_key_here"

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"
